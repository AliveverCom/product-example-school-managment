%%{init: {"theme": "base", "themeVariables": {"background": "#ffffff", "primaryColor": "#ffffff", "secondaryColor": "#ffffff", "tertiaryColor": "#ffffff", "primaryTextColor": "#1f2937", "lineColor": "#64748b", "fontFamily": "PingFang SC, Microsoft YaHei, sans-serif"}}}%%
flowchart TD
    start([开始])

    subgraph coreFlow[核心业务对象流程]
        direction TB
        A[创建班级]
        B[创建课程]
        C[将课程分配到班级]
        D[创建老师]
        E[定义老师可教授的课程]
        F[将老师及课程分配到班级]
        G[创建学生]
        H[将学生分配到班级]
    end

    subgraph teachingFlow[教学测评对象流程]
        direction TB
        I[创建考试并定义所属班级、课程及考试属性]
        J[进行成绩录入]
        K[成绩关联班级 / 课程 / 考试 / 学生]
    end

    finish([完成])

    start --> A
    A --> B
    B --> C
    C --> D
    D --> E
    E --> F
    F --> G
    G --> H
    H --> I
    I --> J
    J --> K
    K --> finish

    classDef coreNode fill:#eef7ff,stroke:#7aa6d8,stroke-width:1.2px,color:#1f2937;
    classDef mappingNode fill:#fff8e8,stroke:#d8b56a,stroke-width:1.2px,color:#1f2937;
    classDef teachingNode fill:#eefcf3,stroke:#78b88f,stroke-width:1.2px,color:#1f2937;
    classDef termNode fill:#f1f5f9,stroke:#94a3b8,stroke-width:1.2px,color:#1f2937;

    class A,B,D,G coreNode;
    class C,E,F,H mappingNode;
    class I,J,K teachingNode;
    class start,finish termNode;

    linkStyle 0,1,3,6 stroke:#3b82f6,stroke-width:2px;
    linkStyle 2,4,5,7 stroke:#f59e0b,stroke-width:2px;
    linkStyle 8 stroke:#94a3b8,stroke-width:2px,stroke-dasharray:5 5;
    linkStyle 9,10,11 stroke:#10b981,stroke-width:2px;

    style coreFlow fill:#f8fbff,stroke:#c7d9ee,stroke-width:1px,color:#1f2937;
    style teachingFlow fill:#f7fff9,stroke:#c7e7cf,stroke-width:1px,color:#1f2937;
