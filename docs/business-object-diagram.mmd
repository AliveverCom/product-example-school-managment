%%{init: {"theme": "base", "themeVariables": {"background": "#ffffff", "primaryColor": "#ffffff", "secondaryColor": "#ffffff", "tertiaryColor": "#ffffff", "primaryTextColor": "#1f2937", "lineColor": "#64748b", "fontFamily": "PingFang SC, Microsoft YaHei, sans-serif"}}}%%
flowchart LR
    subgraph core[核心业务对象]
        direction TB
        student[学生]
        teacher[老师]
        schoolClass[班级]
        course[课程]
    end

    subgraph teaching[教学测评对象]
        direction TB
        exam[考试]
        score[成绩]
    end

    subgraph mapping[关系映射对象]
        direction TB
        courseTeacher[课程-老师对照表]
        classStudent[班级-学生对照表]
        classCourseTeacher[班级-课程-老师对照表]
    end

    schoolClass -->|班主任| teacher
    exam --> course
    exam --> schoolClass
    score --> student
    score --> exam

    courseTeacher --> course
    courseTeacher --> teacher

    classStudent --> schoolClass
    classStudent --> student

    classCourseTeacher --> schoolClass
    classCourseTeacher --> course
    classCourseTeacher --> teacher

    classDef coreNode fill:#eef7ff,stroke:#7aa6d8,stroke-width:1.2px,color:#1f2937;
    classDef teachingNode fill:#eefcf3,stroke:#78b88f,stroke-width:1.2px,color:#1f2937;
    classDef mappingNode fill:#fff8e8,stroke:#d8b56a,stroke-width:1.2px,color:#1f2937;

    class student,teacher,schoolClass,course coreNode;
    class exam,score teachingNode;
    class courseTeacher,classStudent,classCourseTeacher mappingNode;

    linkStyle 0,5,7 stroke:#f59e0b,stroke-width:2.4px;
    linkStyle 1,4,8 stroke:#3b82f6,stroke-width:2.4px;
    linkStyle 2,6,9 stroke:#10b981,stroke-width:2.4px;
    linkStyle 3 stroke:#ef4444,stroke-width:2.4px;

    style core fill:#f8fbff,stroke:#c7d9ee,stroke-width:1px,color:#1f2937;
    style teaching fill:#f7fff9,stroke:#c7e7cf,stroke-width:1px,color:#1f2937;
    style mapping fill:#fffdf7,stroke:#ead9ab,stroke-width:1px,color:#1f2937;